  {
    "id": "f10",
    "type": "function",
    "name": "/start, /info и echo",
    "x": 430,
    "y": 120,
    "wires": [
      [
        "send10"
      ]
    ],
    "func": "if (!msg.payload || msg.payload.type !== 'message') return null;\nconst text = String(msg.payload.content || '');\nconst command = text.split(/\\s+/)[0].split('@')[0];\nlet reply;\nif (command === '/start') { reply = 'Привет! Я бот Беляевой, СДП-ИИ-241. Команда /info расскажет о лабораторной. Остальные сообщения я повторяю.'; }\nelse if (command === '/info') { reply = 'Лабораторная №2: Node-RED. Беляева, СДП-ИИ-241. Ачивка №1 — локальный MQTT.'; }\nelse { reply = 'Эхо: ' + text; }\nmsg.payload = {chatId:msg.payload.chatId,type:'message',content:reply};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
