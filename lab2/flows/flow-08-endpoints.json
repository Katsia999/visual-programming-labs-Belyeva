        "r08-3"
      ]
    ],
    "func": "const items = [{id:1,name:'Пицца'},{id:2,name:'Салат'},{id:3,name:'Суп'}];\nconst id = msg.req.query.id;\nmsg.headers = {'Content-Type':'application/json; charset=utf-8'};\nif (id === undefined) { msg.payload = items; }\nelse if (!/^[1-9][0-9]*$/.test(String(id))) { msg.statusCode = 400; msg.payload = {error:'id должен быть положительным целым числом'}; }\nelse { const item = items.find(item => item.id === Number(id)); if (item) { msg.payload = item; } else { msg.statusCode = 404; msg.payload = {error:'Блюдо не найдено'}; } }\nreturn msg;",
