    <bpmn:sequenceFlow id="Flow_ToChangeGateway" sourceRef="Task_Unavailable" targetRef="Gateway_Change" />
    <bpmn:sequenceFlow id="Flow_ChangeYes" name="Да" sourceRef="Gateway_Change" targetRef="Task_ChangeOrder" />
    <bpmn:sequenceFlow id="Flow_ChangeNo" name="Нет" sourceRef="Gateway_Change" targetRef="EndEvent_Cancel" />
    <bpmn:sequenceFlow id="Flow_RetryBack" sourceRef="Task_RetryPayment" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_4" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_5" targetRef="Gateway_Payment" />
    <bpmn:sequenceFlow id="Flow_PaymentYes" name="Да" sourceRef="Gateway_Payment" targetRef="Activity_1kcy708" />
    <bpmn:sequenceFlow id="Flow_PaymentNo" name="Нет" sourceRef="Gateway_Payment" targetRef="Task_RetryPayment" />
    <bpmn:sequenceFlow id="Flow_ToParallelSplit" sourceRef="Task_Confirm" targetRef="Gateway_ParallelSplit" />
    <bpmn:sequenceFlow id="Flow_ToPrep" sourceRef="Gateway_ParallelSplit" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_ToSearchCourier" sourceRef="Gateway_ParallelSplit" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_6" targetRef="Task_8" />
    <bpmn:sequenceFlow id="Flow_ToParallelJoin1" sourceRef="Task_8" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_7" targetRef="Task_AssignCourier" />
    <bpmn:sequenceFlow id="Flow_ToParallelJoin2" sourceRef="Task_AssignCourier" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_ParallelJoin" targetRef="Task_9" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_9" targetRef="Task_10" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_10" targetRef="Task_11" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_11" targetRef="Task_Complete" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Complete" targetRef="Task_12" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_12" targetRef="EndEvent_1" />
    <bpmn:task id="Activity_1kcy708" name="Отправить подтверждение заказа">
      <bpmn:incoming>Flow_PaymentYes</bpmn:incoming>
      <bpmn:outgoing>Flow_1f0k21h</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1f0k21h" sourceRef="Activity_1kcy708" targetRef="Task_Confirm" />
  </bpmn:process>
