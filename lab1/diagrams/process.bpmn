<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_FoodDelivery" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.28.0">
  <bpmn:collaboration id="Collaboration_1t7b3im">
    <bpmn:participant id="Participant_0j7x9ga" processRef="Process_FoodDelivery" />
  </bpmn:collaboration>
  <bpmn:process id="Process_FoodDelivery" name="Заказ еды в ресторане с доставкой" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1dwb45m" name="Клиент">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChangeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0ehhmwy" name="Приложение">
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Unavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetryPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignCourier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0jpvxyk" name="Ресторан">
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1pr8rsi" name="Платежная система">
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1kcy708</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1snaetu" name="Курьер">
        <bpmn:flowNodeRef>Task_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_10</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Начало">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_1" name="1. Выбирает ресторан, блюда и формирует заказ">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_2" name="2. Отправляет заказ в ресторан">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:incoming>Flow_ChangeBack</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Check" name="3. Проверяет наличие блюд">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Available" name="Все блюда доступны?">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_AvailableYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_AvailableNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Unavailable" name="Сообщает об отсутствии блюда и предлагает замену/отмену">
      <bpmn:incoming>Flow_AvailableNo</bpmn:incoming>
      <bpmn:outgoing>Flow_ToChangeGateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Change" name="Изменить заказ?">
      <bpmn:incoming>Flow_ToChangeGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ChangeYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ChangeNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ChangeOrder" name="Клиент изменяет заказ">
      <bpmn:incoming>Flow_ChangeYes</bpmn:incoming>
      <bpmn:outgoing>Flow_ChangeBack</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Cancel" name="Заказ отменён">
      <bpmn:incoming>Flow_ChangeNo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_4" name="4. Выбирает способ оплаты и оплачивает заказ">
      <bpmn:incoming>Flow_AvailableYes</bpmn:incoming>
      <bpmn:incoming>Flow_RetryBack</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_5" name="5. Обрабатывает оплату">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Payment" name="Оплата успешна?">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RetryPayment" name="Повторяет оплату или выбирает другой способ">
      <bpmn:incoming>Flow_PaymentNo</bpmn:incoming>
      <bpmn:outgoing>Flow_RetryBack</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Confirm" name="Подтверждает заказ">
      <bpmn:incoming>Flow_1f0k21h</bpmn:incoming>
      <bpmn:outgoing>Flow_ToParallelSplit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Параллельно">
      <bpmn:incoming>Flow_ToParallelSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPrep</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToSearchCourier</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_6" name="6. Начинает приготовление еды">
      <bpmn:incoming>Flow_ToPrep</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_8" name="8. Упаковывает заказ и ставит статус «Готов к выдаче»">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_ToParallelJoin1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_7" name="7. Ищет свободного курьера">
      <bpmn:incoming>Flow_ToSearchCourier</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AssignCourier" name="Назначает курьера">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_ToParallelJoin2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_ParallelJoin">
      <bpmn:incoming>Flow_ToParallelJoin1</bpmn:incoming>
      <bpmn:incoming>Flow_ToParallelJoin2</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_9" name="9. Приезжает в ресторан и забирает заказ">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_10" name="10. Доставляет заказ клиенту; приложение показывает местоположение">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_11" name="11. Получает заказ и подтверждает получение">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Complete" name="12. Завершает заказ и предлагает оценить ресторан и доставку">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_12" name="Оценивает ресторан и качество доставки">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Конец">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_ChangeBack" sourceRef="Task_ChangeOrder" targetRef="Task_2" />
